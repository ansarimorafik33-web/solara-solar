<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">Solar Energy — Est. <%= site.yearFounded %></p>
      <h1 class="hero-title">
        <span>Power the</span>
        <span class="display-italic">future</span>
        <span>. Naturally.</span>
      </h1>
      <p class="hero-lead">Premium solar systems for homes, businesses, and next-generation energy resilience — built to feel as beautiful as they perform.</p>
      <div class="hero-actions">
        <a class="button primary" href="#quote-form">Get a free quote</a>
        <a class="button secondary" href="#projects">View projects</a>
      </div>
    </div>
    <div class="hero-visual" aria-label="Solar sun graphic">
      <div id="hero-scene"></div>
    </div>
  </div>
  <div class="scroll-indicator"><span>Scroll</span></div>
</section>
